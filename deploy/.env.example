# Public NFC Auth provider origin and the separate terminal-only mTLS origin.
NFCAUTH_SERVICE_ID=example-provider
NFCAUTH_SERVICE_ORIGIN=https://nfc-auth.example.com
NFCAUTH_PUBLIC_HOSTNAME=nfc-auth.example.com
NFCAUTH_TERMINAL_HOSTNAME=nfc-terminal.example.com

# Set this to a registry image after publishing one. The default builds and
# tags nfcauth-bridge:4.0.0 from ../python.
NFCAUTH_BRIDGE_IMAGE=nfcauth-bridge:4.0.0

POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Provider-side credential retention. A verified authentication or explicit
# user-approved renewal resets the lifetime. Expired rows are removed after the
# grace period; the phone sends no heartbeat.
NFCAUTH_CREDENTIAL_LIFETIME_DAYS=548
NFCAUTH_CREDENTIAL_CLEANUP_GRACE_DAYS=30
NFCAUTH_CREDENTIAL_CLEANUP_INTERVAL_SECONDS=86400

# Authentik confidential OAuth2/OIDC provider used for account linking.
OIDC_ISSUER=https://authentik.example.com/application/o/nfcauth/
OIDC_AUTHORIZATION_ENDPOINT=https://authentik.example.com/application/o/authorize/
OIDC_TOKEN_ENDPOINT=https://authentik.example.com/application/o/token/
OIDC_JWKS_URI=https://authentik.example.com/application/o/nfcauth/jwks/
OIDC_CLIENT_ID=REPLACE_WITH_AUTHENTIK_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_AUTHENTIK_CLIENT_SECRET

# Leave these empty to issue bridge-signed JWTs. Authentik token exchange needs
# Authentik 2026.8+, explicit federation trust, and end-to-end validation.
TOKEN_EXCHANGE_ENDPOINT=
TOKEN_EXCHANGE_CLIENT_ID=
TOKEN_EXCHANGE_CLIENT_SECRET=

# Used only with docker-compose.authentik.yml.
AUTHENTIK_DOCKER_NETWORK=authentik_default
